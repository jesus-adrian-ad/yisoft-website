# Formulario de contacto (sección "Hablemos")
#
# Las tres son de servidor: se leen dentro de la Server Action
# app/acciones/enviar-contacto.ts y NUNCA llegan al navegador. Ninguna lleva
# el prefijo NEXT_PUBLIC_, que es lo que las expondría en el bundle.
#
# Si falta alguna, el build NO se rompe: la acción falla de forma controlada y
# el formulario muestra su mensaje de error con la salida alternativa (correo
# y WhatsApp a la vista). El fallo queda en los registros del servidor.

# Clave de API de Resend. Se saca de https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Buzón que recibe los mensajes del formulario.
CONTACTO_CORREO_DESTINO=jesus-adrian@yisoft-development.com

# Remitente técnico. Su dominio tiene que estar verificado en Resend, o la
# API rechaza el envío. No es un buzón donde se lea nada: las respuestas van
# por `replyTo`, que apunta a quien escribió desde la web.
CONTACTO_CORREO_REMITENTE=formulario@yisoft-development.com
